[Unit]
Description=Sync OS-provided Flatpaks from preinstall.d
Documentation=man:flatpak-preinstall(1)
Wants=network-online.target
After=network-online.target flatpak-add-flathub-repos.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak preinstall --system -y --noninteractive
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
