From: Cappy Ishihara <cappy@cappuchino.xyz>
Date: Fri, 5 Dec 2025 04:58:02 +0700
Subject: [PATCH] Revert "PackageKit: Never run on rpm-ostree managed systems"

This reverts commit b7ed897e6842002b195c02c6e89f4e06aee12d09.
---
 libdiscover/backends/PackageKitBackend/PackageKitBackend.h | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/libdiscover/backends/PackageKitBackend/PackageKitBackend.h b/libdiscover/backends/PackageKitBackend/PackageKitBackend.h
index 629492073..b789b1097 100644
--- a/libdiscover/backends/PackageKitBackend/PackageKitBackend.h
+++ b/libdiscover/backends/PackageKitBackend/PackageKitBackend.h
@@ -10,7 +10,6 @@
 
 #include <PackageKit/Offline>
 #include <PackageKit/Transaction>
-#include <QFile>
 #include <QPointer>
 #include <QSet>
 #include <QSharedPointer>
@@ -87,7 +86,7 @@ public:
     Transaction *removeApplication(AbstractResource *app) override;
     bool isValid() const override
     {
-        return !QFile::exists(QStringLiteral("/run/ostree-booted"));
+        return true;
     }
     QSet<AbstractResource *> upgradeablePackages() const;
 
